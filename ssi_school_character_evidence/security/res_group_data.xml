<odoo>
<!-- Workflow tier groups for the Character Observation document:
     User (records observations and evidence) < Officer (reviews/approves) <
     Manager (owns the character observation policy). -->
<record id="school_character_observation_user_group" model="res.groups">
    <field name="name">User</field>
    <field
            name="category_id"
            ref="school_character_observation_workflow_module_category"
        />
</record>

<record id="school_character_observation_officer_group" model="res.groups">
    <field name="name">Officer</field>
    <field
            name="category_id"
            ref="school_character_observation_workflow_module_category"
        />
    <field
            name="implied_ids"
            eval="[(4, ref('school_character_observation_user_group'))]"
        />
</record>

<record id="school_character_observation_manager_group" model="res.groups">
    <field name="name">Manager</field>
    <field
            name="category_id"
            ref="school_character_observation_workflow_module_category"
        />
    <field
            name="implied_ids"
            eval="[(4, ref('school_character_observation_officer_group'))]"
        />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

<!-- Workflow tier groups for the Character Teacher Calibration document:
     User (runs calibration sessions) < Officer (reviews/approves) <
     Manager (owns the calibration policy). -->
<record id="school_character_calibration_user_group" model="res.groups">
