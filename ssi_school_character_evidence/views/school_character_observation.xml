<odoo>
<record id="school_character_observation_view_search" model="ir.ui.view">
    <field name="name">school_character_observation - search</field>
    <field name="model">school_character_observation</field>
    <field
            name="inherit_id"
            ref="ssi_transaction_mixin.mixin_transaction_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="student_id" />
                <field name="construct_id" />
                <field name="subconstruct_id" />
                <field name="academic_year_id" />
                <field name="academic_term_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_student_id"
                            string="Student"
                            context="{'group_by': 'student_id'}"
                        />
                    <filter
                            name="group_by_construct_id"
                            string="Construct"
                            context="{'group_by': 'construct_id'}"
                        />
                    <filter
                            name="group_by_academic_year_id"
                            string="Academic Year"
                            context="{'group_by': 'academic_year_id'}"
                        />
                    <filter
                            name="group_by_academic_term_id"
                            string="Academic Term"
                            context="{'group_by': 'academic_term_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_observation_view_tree" model="ir.ui.view">
    <field name="name">school_character_observation - tree</field>
    <field name="model">school_character_observation</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_tree" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="date" />
                <field name="student_id" />
                <field name="construct_id" />
                <field name="academic_term_id" />
                <field name="provisional_level_id" />
                <field name="evidence_count" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_observation_view_form" model="ir.ui.view">
    <field name="name">school_character_observation - form</field>
    <field name="model">school_character_observation</field>
    <field name="mode">primary</field>
    <field name="inherit_id" ref="ssi_transaction_mixin.mixin_transaction_view_form" />
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='user_id']" position="after">
                <field name="student_id" />
                <field name="construct_id" />
                <field
                        name="subconstruct_id"
                        domain="[('construct_id', '=', construct_id)]"
                    />
                <field name="provisional_level_id" />
            </xpath>
            <xpath expr="//group[@name='header_right']" position="inside">
                <field name="date" />
                <field name="academic_year_id" />
                <field name="academic_term_id" />
                <field name="evidence_count" />
            </xpath>
            <xpath expr="//page[1]" position="before">
                <page name="evidence" string="Evidence Entries">
                    <field name="evidence_ids">
                        <tree editable="bottom">
                            <field name="date" />
                            <field name="activity_id" />
                            <field name="arena_id" />
                            <field
                                    name="indicator_id"
                                    domain="[('construct_id', '=', parent.construct_id)]"
                                />
                            <field name="observer_id" />
                            <field name="context" />
                            <field name="observed_behavior" />
                            <field name="source_type" />
                            <field name="evidence_quality" />
                            <field name="matched_level_id" />
                            <field name="attachment_ids" widget="many2many_tags" />
                        </tree>
                        <form>
                            <group>
                                <field name="date" />
                                <field name="activity_id" />
                                <field name="arena_id" />
                                <field
                                        name="indicator_id"
                                        domain="[('construct_id', '=', parent.construct_id)]"
                                    />
                                <field name="observer_id" />
                                <field name="context" />
                                <field name="observed_behavior" />
                                <field name="source_type" />
                                <field name="evidence_quality" />
                                <field name="matched_level_id" />
                                <field name="attachment_ids" widget="many2many_tags" />
                            </group>
                        </form>
                    </field>
                </page>
                <page name="summary" string="Summary">
                    <group name="summary_group" colspan="4" col="1">
                        <field name="summary" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_observation_action" model="ir.actions.act_window">
    <field name="name">Character Observations</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_observation</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_observation_menu"
        name="Character Observations"
        parent="menu_character_measurement_root"
        action="school_character_observation_action"
        groups="school_character_observation_user_group"
        sequence="10"
    />

</odoo>
