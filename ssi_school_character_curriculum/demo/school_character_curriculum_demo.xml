<!-- Illustrative demo data only. The concrete values below (a pilot school,
     grade, academic year/term, and a GREAT-profile construct-to-arena
     mapping) are examples drawn from a pilot and are NOT part of the
     module's code. They demonstrate that the Character Curriculum Map is
     fully configured per school; nothing here is hardcoded in models or
     views. -->
<odoo>
<!-- ===================== Supporting school master data ===================== -->
<record id="demo_grade_type" model="school_grade_type">
    <field name="name">Character Curriculum Demo Grade Type</field>
    <field name="code">CCM-DEMO-GT</field>
</record>
<record id="demo_school" model="school">
    <field name="name">Character Curriculum Demo School</field>
    <field name="code">CCM-DEMO-SCH</field>
    <field name="grade_type_id" ref="demo_grade_type" />
</record>
<record id="demo_grade" model="school_grade">
    <field name="name">Character Curriculum Demo Grade 7</field>
    <field name="code">CCM-DEMO-G7</field>
    <field name="sequence">10</field>
    <field name="type_id" ref="demo_grade_type" />
</record>
<record id="demo_academic_year" model="school_academic_year">
    <field name="name">Character Curriculum Demo AY 2026/2027</field>
    <field name="code">CCM-DEMO-AY2627</field>
    <field name="date_start">2026-07-01</field>
    <field name="date_end">2027-06-30</field>
</record>
<record id="demo_academic_term" model="school_academic_term">
    <field name="name">Character Curriculum Demo Term 1</field>
    <field name="code">CCM-DEMO-TM1</field>
    <field name="date_start">2026-07-01</field>
    <field name="date_end">2026-12-31</field>
    <field name="year_id" ref="demo_academic_year" />
</record>

<!-- ===================== Character Curriculum Map ===================== -->
<record id="demo_curriculum" model="school_character_curriculum">
    <field name="date">2026-07-01</field>
    <field name="academic_year_id" ref="demo_academic_year" />
    <field name="academic_term_id" ref="demo_academic_term" />
    <field name="school_id" ref="demo_school" />
    <field name="grade_id" ref="demo_grade" />
    <field name="profile_id" ref="ssi_school_character.profile_great" />
    <field name="pathway">core</field>
</record>

<record id="demo_curriculum_line_integrity" model="school_character_curriculum.line">
    <field name="curriculum_id" ref="demo_curriculum" />
    <field name="construct_id" ref="ssi_school_character.construct_integrity" />
    <field name="subconstruct_id" ref="ssi_school_character.subconstruct_honesty" />
    <field name="arena_id" ref="ssi_school_character.arena_classroom" />
    <field name="method_id" ref="ssi_school_character.method_modeling" />
    <field name="target_level_id" ref="ssi_school_character.level_iclad_consistent" />
    <field name="track">intracurricular</field>
    <field
            name="capaian"
        >The learner consistently tells the truth and admits mistakes in classroom situations without prompting.</field>
    <field
            name="indicator_ids"
            eval="[(6, 0, [ref('ssi_school_character.indicator_admit_mistake')])]"
        />
</record>

<record id="demo_curriculum_line_service" model="school_character_curriculum.line">
    <field name="curriculum_id" ref="demo_curriculum" />
    <field name="construct_id" ref="ssi_school_character.construct_service" />
    <field name="arena_id" ref="ssi_school_character.arena_school_culture_5s" />
    <field name="method_id" ref="ssi_school_character.method_service_learning" />
    <field name="target_level_id" ref="ssi_school_character.level_iclad_developing" />
    <field name="track">student_affairs</field>
    <field
            name="capaian"
        >The learner initiates helping peers during school-culture routines with occasional support.</field>
</record>
</odoo>
