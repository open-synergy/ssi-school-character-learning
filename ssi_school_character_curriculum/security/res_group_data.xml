<odoo>
<!-- Workflow tier groups for the Character Curriculum Map document:
     User (drafts and maintains maps) < Officer (reviews/approves) <
     Manager (owns the character curriculum policy). -->
<record id="school_character_curriculum_user_group" model="res.groups">
    <field name="name">User</field>
    <field
            name="category_id"
            ref="school_character_curriculum_workflow_module_category"
        />
</record>

<record id="school_character_curriculum_officer_group" model="res.groups">
    <field name="name">Officer</field>
    <field
            name="category_id"
            ref="school_character_curriculum_workflow_module_category"
        />
    <field
            name="implied_ids"
            eval="[(4, ref('school_character_curriculum_user_group'))]"
        />
</record>

<record id="school_character_curriculum_manager_group" model="res.groups">
    <field name="name">Manager</field>
    <field
            name="category_id"
            ref="school_character_curriculum_workflow_module_category"
        />
    <field
            name="implied_ids"
            eval="[(4, ref('school_character_curriculum_officer_group'))]"
        />
    <field
            name="users"
            eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"
        />
</record>

</odoo>
