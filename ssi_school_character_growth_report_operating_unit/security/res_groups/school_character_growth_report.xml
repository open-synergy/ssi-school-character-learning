<odoo>

<!-- Single "Operating Unit" group for the character growth report family:
     the base ssi_school_character_growth_report module defines one shared
     workflow tier hierarchy (User/Officer/Manager) and one shared data
     ownership category, so this OU group is hung off that shared data
     ownership category. -->
<record id="school_character_growth_report_operating_unit_group" model="res.groups">
    <field name="name">Operating Unit</field>
    <field
            name="category_id"
            ref="ssi_school_character_growth_report.school_character_growth_report_data_ownership_module_category"
        />
</record>

<!-- Manager is the top workflow tier: wire it into the new OU group so
     Managers are also evaluated against the OU-scoped ir.rule below. Uses
     (4, ...) to ADD to the existing implied_ids (already pointing at the
     Officer group from the base module) instead of (6, 0, ...), which
     would clobber that link. -->
<record
        id="ssi_school_character_growth_report.school_character_growth_report_manager_group"
        model="res.groups"
    >
    <field
            name="implied_ids"
            eval="[(4, ref('school_character_growth_report_operating_unit_group'))]"
        />
</record>

</odoo>
