<odoo>
<record id="school_character_profile_view_search" model="ir.ui.view">
    <field name="name">school_character_profile - search</field>
    <field name="model">school_character_profile</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="school_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_school"
                            string="School"
                            context="{'group_by': 'school_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_profile_view_tree" model="ir.ui.view">
    <field name="name">school_character_profile - tree</field>
    <field name="model">school_character_profile</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="school_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_profile_view_form" model="ir.ui.view">
    <field name="name">school_character_profile - form</field>
    <field name="model">school_character_profile</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="profile" string="Profile">
                    <group name="profile_group_1" string="Profile Configuration">
                        <field name="school_id" />
                    </group>
                    <group name="profile_group_2" string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </page>
                <page name="construct" string="Constructs">
                    <field name="construct_ids">
                        <tree>
                            <field name="code" />
                            <field name="name" />
                            <field name="family_id" />
                            <field name="scale_id" />
                        </tree>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_profile_action" model="ir.actions.act_window">
    <field name="name">Character Profiles</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_profile</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_profile_menu"
        name="Character Profiles"
        parent="menu_character_configuration"
        action="school_character_profile_action"
        groups="school_character_user_group"
        sequence="60"
    />

</odoo>
