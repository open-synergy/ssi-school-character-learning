<odoo>
<record id="school_character_rubric_view_search" model="ir.ui.view">
    <field name="name">school_character_rubric - search</field>
    <field name="model">school_character_rubric</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="construct_id" />
                <field name="scale_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_construct"
                            string="Construct"
                            context="{'group_by': 'construct_id'}"
                        />
                    <filter
                            name="group_by_scale"
                            string="Scale"
                            context="{'group_by': 'scale_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_rubric_view_tree" model="ir.ui.view">
    <field name="name">school_character_rubric - tree</field>
    <field name="model">school_character_rubric</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="construct_id" />
                <field name="scale_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_rubric_view_form" model="ir.ui.view">
    <field name="name">school_character_rubric - form</field>
    <field name="model">school_character_rubric</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="rubric" string="Rubric">
                    <group name="rubric_group_1" string="Classification">
                        <field name="construct_id" />
                        <field name="scale_id" />
                    </group>
                </page>
                <page name="descriptor" string="Descriptors">
                    <field name="descriptor_ids">
                        <tree editable="bottom">
                            <field name="level_id" />
                            <field name="descriptor" />
                            <field name="criteria" />
                        </tree>
                        <form>
                            <group>
                                <field name="level_id" />
                                <field name="descriptor" />
                                <field name="criteria" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_rubric_action" model="ir.actions.act_window">
    <field name="name">Character Rubrics</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_rubric</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_rubric_menu"
        name="Character Rubrics"
        parent="menu_character_configuration"
        action="school_character_rubric_action"
        groups="school_character_user_group"
        sequence="100"
    />

</odoo>
