<odoo>
<record id="school_character_construct_view_search" model="ir.ui.view">
    <field name="name">school_character_construct - search</field>
    <field name="model">school_character_construct</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="profile_id" />
                <field name="family_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_profile"
                            string="Profile"
                            context="{'group_by': 'profile_id'}"
                        />
                    <filter
                            name="group_by_family"
                            string="Family"
                            context="{'group_by': 'family_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_construct_view_tree" model="ir.ui.view">
    <field name="name">school_character_construct - tree</field>
    <field name="model">school_character_construct</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="profile_id" />
                <field name="family_id" />
                <field name="scale_id" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_construct_view_form" model="ir.ui.view">
    <field name="name">school_character_construct - form</field>
    <field name="model">school_character_construct</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="construct" string="Construct">
                    <group name="construct_group_1" string="Classification">
                        <field name="profile_id" />
                        <field name="family_id" />
                        <field name="scale_id" />
                    </group>
                    <group name="construct_group_2" string="Definition">
                        <field name="definition" nolabel="1" />
                    </group>
                    <group name="construct_group_3" string="Boundary Statement">
                        <field name="boundary_statement" nolabel="1" />
                    </group>
                </page>
                <page name="method" string="Methods">
                    <field name="method_ids">
                        <tree>
                            <field name="code" />
                            <field name="name" />
                        </tree>
                    </field>
                </page>
                <page name="subconstruct" string="Sub-constructs">
                    <field name="subconstruct_ids">
                        <tree>
                            <field name="code" />
                            <field name="name" />
                        </tree>
                        <form>
                            <group>
                                <field name="code" />
                                <field name="name" />
                                <field name="definition" nolabel="1" />
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_construct_action" model="ir.actions.act_window">
    <field name="name">Character Constructs</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_construct</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_construct_menu"
        name="Character Constructs"
        parent="menu_character_configuration"
        action="school_character_construct_action"
        groups="school_character_user_group"
        sequence="70"
    />

</odoo>
