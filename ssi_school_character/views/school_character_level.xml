<odoo>
<record id="school_character_level_view_search" model="ir.ui.view">
    <field name="name">school_character_level - search</field>
    <field name="model">school_character_level</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="scale_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_scale"
                            string="Scale"
                            context="{'group_by': 'scale_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_level_view_tree" model="ir.ui.view">
    <field name="name">school_character_level - tree</field>
    <field name="model">school_character_level</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="scale_id" />
                <field name="sequence" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_level_view_form" model="ir.ui.view">
    <field name="name">school_character_level - form</field>
    <field name="model">school_character_level</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="level" string="Level">
                    <group name="level_group_1" string="Level Configuration">
                        <field name="scale_id" />
                        <field name="sequence" />
                    </group>
                    <group name="level_group_2" string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_level_action" model="ir.actions.act_window">
    <field name="name">Character Levels</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_level</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_level_menu"
        name="Character Levels"
        parent="menu_character_configuration"
        action="school_character_level_action"
        groups="school_character_user_group"
        sequence="20"
    />

</odoo>
