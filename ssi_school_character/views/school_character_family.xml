<odoo>
<record id="school_character_family_view_search" model="ir.ui.view">
    <field name="name">school_character_family - search</field>
    <field name="model">school_character_family</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="school_character_family_view_tree" model="ir.ui.view">
    <field name="name">school_character_family - tree</field>
    <field name="model">school_character_family</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data />
    </field>
</record>

<record id="school_character_family_view_form" model="ir.ui.view">
    <field name="name">school_character_family - form</field>
    <field name="model">school_character_family</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="family" string="Family">
                    <group name="family_group_1" string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_family_action" model="ir.actions.act_window">
    <field name="name">Character Families</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_family</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_family_menu"
        name="Character Families"
        parent="menu_character_configuration"
        action="school_character_family_action"
        groups="school_character_user_group"
        sequence="30"
    />

</odoo>
