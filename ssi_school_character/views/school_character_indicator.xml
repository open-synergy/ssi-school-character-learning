<odoo>
<record id="school_character_indicator_view_search" model="ir.ui.view">
    <field name="name">school_character_indicator - search</field>
    <field name="model">school_character_indicator</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="construct_id" />
                <field name="subconstruct_id" />
                <field name="indicator_type" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_construct"
                            string="Construct"
                            context="{'group_by': 'construct_id'}"
                        />
                    <filter
                            name="group_by_indicator_type"
                            string="Indicator Type"
                            context="{'group_by': 'indicator_type'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_indicator_view_tree" model="ir.ui.view">
    <field name="name">school_character_indicator - tree</field>
    <field name="model">school_character_indicator</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="construct_id" />
                <field name="subconstruct_id" />
                <field name="indicator_type" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_indicator_view_form" model="ir.ui.view">
    <field name="name">school_character_indicator - form</field>
    <field name="model">school_character_indicator</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="indicator" string="Indicator">
                    <group name="indicator_group_1" string="Classification">
                        <field name="construct_id" />
                        <field name="subconstruct_id" />
                        <field name="indicator_type" />
                    </group>
                    <group name="indicator_group_2" string="Scope">
                        <field name="grade_type_id" />
                        <field name="grade_id" />
                    </group>
                    <group name="indicator_group_3" string="Cognitive Demand">
                        <field name="rbt_level" />
                        <field name="dok_level" />
                        <field name="solo_level" />
                    </group>
                    <group name="indicator_group_4" string="Description">
                        <field name="description" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_indicator_action" model="ir.actions.act_window">
    <field name="name">Character Indicators</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_indicator</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_indicator_menu"
        name="Character Indicators"
        parent="menu_character_configuration"
        action="school_character_indicator_action"
        groups="school_character_user_group"
        sequence="90"
    />

</odoo>
