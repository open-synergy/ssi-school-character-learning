<odoo>
<record id="school_character_anchor_view_search" model="ir.ui.view">
    <field name="name">school_character_anchor - search</field>
    <field name="model">school_character_anchor</field>
    <field
            name="inherit_id"
            ref="ssi_master_data_mixin.mixin_master_data_view_search"
        />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//search" position="inside">
                <field name="construct_id" />
                <field name="level_id" />
                <group expand="0" string="Group By">
                    <filter
                            name="group_by_construct"
                            string="Construct"
                            context="{'group_by': 'construct_id'}"
                        />
                    <filter
                            name="group_by_level"
                            string="Level"
                            context="{'group_by': 'level_id'}"
                        />
                </group>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_anchor_view_tree" model="ir.ui.view">
    <field name="name">school_character_anchor - tree</field>
    <field name="model">school_character_anchor</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_tree" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//field[@name='code']" position="after">
                <field name="construct_id" />
                <field name="level_id" />
                <field name="source_type" />
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_anchor_view_form" model="ir.ui.view">
    <field name="name">school_character_anchor - form</field>
    <field name="model">school_character_anchor</field>
    <field name="inherit_id" ref="ssi_master_data_mixin.mixin_master_data_view_form" />
    <field name="mode">primary</field>
    <field name="arch" type="xml">
        <data>
            <xpath expr="//notebook/page[@name='note']" position="before">
                <page name="anchor" string="Anchor">
                    <group name="anchor_group_1" string="Classification">
                        <field name="construct_id" />
                        <field name="level_id" />
                        <field name="grade_type_id" />
                        <field name="source_type" />
                    </group>
                    <group name="anchor_group_2" string="Sample">
                        <field name="sample_text" nolabel="1" />
                    </group>
                </page>
            </xpath>
        </data>
    </field>
</record>

<record id="school_character_anchor_action" model="ir.actions.act_window">
    <field name="name">Character Anchors</field>
    <field name="type">ir.actions.act_window</field>
    <field name="res_model">school_character_anchor</field>
    <field name="view_mode">tree,form</field>
</record>

<menuitem
        id="school_character_anchor_menu"
        name="Character Anchors"
        parent="menu_character_configuration"
        action="school_character_anchor_action"
        groups="school_character_user_group"
        sequence="110"
    />

</odoo>
